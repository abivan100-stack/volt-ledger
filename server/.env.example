NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Trust forwarded client headers only when the service is behind a managed proxy.
TRUST_PROXY=false
WEB_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=volt
# Optional comma-separated resolvers for MongoDB Atlas SRV lookups when the
# system DNS resolver times out. Example: 8.8.8.8,1.1.1.1
VOLT_DNS_SERVERS=

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:4000
SIMULATION_DAILY_RUN_LIMIT=100
# Claims allowed per run before it is quarantined as permanently failing.
SIMULATION_MAX_ATTEMPTS=5
# Identity this worker writes its heartbeat under. Give each instance its own.
WORKER_ID=volt-worker

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
# Development-only sender; replace with an address on a verified Resend domain in production.
EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Integration tests (optional; the suite skips without these).
# Must be a REPLICA SET - MongoDB transactions do not work on a standalone server.
# The named database is emptied between tests, so it must be disposable, its name
# must contain "test", and it must differ from MONGODB_DB_NAME above.
MONGODB_TEST_URI=
MONGODB_TEST_DB_NAME=volt_test
# Only if your network refuses Node's system DNS resolver (mongodb+srv SRV lookups fail).
# VOLT_TEST_DNS_SERVERS=8.8.8.8,1.1.1.1
