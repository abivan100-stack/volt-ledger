NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Trust forwarded client headers only when the service is behind a managed proxy.
TRUST_PROXY=false
# Production requires an HTTPS origin; HTTP is allowed only in development/test.
WEB_ORIGIN=http://localhost:5173
# On Render both of the URL settings above default to RENDER_EXTERNAL_URL, the
# address the service is reachable at. Set them here only when the site is served
# from a different origin than the API.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=volt
# Optional comma-separated resolvers for MongoDB Atlas SRV lookups when the
# system DNS resolver times out. Example: 8.8.8.8,1.1.1.1
VOLT_DNS_SERVERS=

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Production requires an HTTPS API origin; HTTP is allowed only in development/test.
BETTER_AUTH_URL=http://localhost:4000
SIMULATION_DAILY_RUN_LIMIT=100
# Claims allowed per run before it is quarantined as permanently failing.
SIMULATION_MAX_ATTEMPTS=5
# Identity this worker writes its heartbeat under. Give each instance its own.
WORKER_ID=volt-worker
# Days an archived organisation stays recoverable before its working data is purged.
RETENTION_WINDOW_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
# Development-only sender; it can deliver only to the Resend account owner.
# Replace it with an address on your verified Resend domain in production so
# verification and invitation emails can reach every recipient.
EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Integration tests (optional; the suite skips without these).
# Must be a REPLICA SET - MongoDB transactions do not work on a standalone server.
# The named database is emptied between tests, so it must be disposable, its name
# must contain "test", and it must differ from MONGODB_DB_NAME above.
MONGODB_TEST_URI=
MONGODB_TEST_DB_NAME=volt_test
# Only if your network refuses Node's system DNS resolver (mongodb+srv SRV lookups fail).
# VOLT_TEST_DNS_SERVERS=8.8.8.8,1.1.1.1

# Public browser-demo persistence. When false the demo ingest routes refuse and
# the browser simulation runs purely in memory.
#
# Needs a REPLICA SET. Every demo write spans several collections that have to
# agree, which a standalone server cannot promise, so against one the routes
# answer 503 and the browser simulates without storing anything. The simulation
# itself works either way.
DEMO_PERSISTENCE_ENABLED=true
# Days a demo session's rows survive before their TTL indexes remove them.
DEMO_RETENTION_DAYS=30

# Serve the built browser bundle (dist/) from this process, putting the site and
# the API on one origin. Requires `npm run build` to have run. Off by default:
# in development the site is served by Vite on its own port.
SERVE_WEB=false
