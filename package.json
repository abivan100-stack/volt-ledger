{
  "name": "volt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run --config server/vitest.config.ts",
    "test:integration": "vitest run --config server/vitest.integration.config.ts",
    "typecheck:api": "tsc -p server/tsconfig.json --noEmit",
    "build:api": "tsc -p server/tsconfig.json",
    "openapi:write": "tsx server/src/openapi/write.ts",
    "openapi:check": "tsx server/src/openapi/check.ts",
    "dev:api": "tsx watch server/src/api.ts",
    "dev:worker": "tsx watch server/src/worker.ts",
    "worker": "tsx server/src/worker.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/spline-sans-mono": "^5.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@types/nodemailer": "^8.0.1",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "js-sha256": "^0.11.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mongodb": "^7.5.0",
    "motion": "^13.1.1",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "resend": "^6.20.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
