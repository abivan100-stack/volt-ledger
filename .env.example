# Client (Vite) environment. Values prefixed with VITE_ are compiled into the
# browser bundle and are therefore PUBLIC. Never put MongoDB credentials,
# Better Auth secrets, or Resend keys here — those belong in server/.env.

# Absolute origin of the Volt REST API.
# Leave unset to build the browser-only demo with no backend calls.
VITE_API_BASE_URL=http://localhost:4000
